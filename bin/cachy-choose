#!/usr/bin/env python3
# ==============================================================================
#   cachy-gnome-tweaks - bin/cachy-choose
#   Purpose: Interactive wrapper around 'gum choose' that maps Space bar (0x20) -> 'x' (0x78)
#            to ensure Space bar toggles selection properly in gum 2.0+.
# ==============================================================================
import sys
import os
import pty
import tty
import termios
import select
import subprocess
import fcntl
import struct
import signal
import shutil

def get_terminal_size(fd):
    try:
        res = fcntl.ioctl(fd, termios.TIOCGWINSZ, b'\x00' * 8)
        return struct.unpack('HHHH', res)
    except Exception:
        return (24, 80, 0, 0)

def set_terminal_size(fd, rows, cols, xpix=0, ypix=0):
    try:
        fcntl.ioctl(fd, termios.TIOCSWINSZ, struct.pack('HHHH', rows, cols, xpix, ypix))
    except Exception:
        pass

def main():
    args = sys.argv[1:]

    if not shutil.which("gum"):
        sys.stderr.write("[ERROR] 'gum' utility not found. Please install gum via pacman.\n")
        sys.exit(1)

    # If stdin is not a TTY (e.g. piped or automated script), run gum choose directly
    if not sys.stdin.isatty():
        res = subprocess.run(["gum", "choose"] + args)
        sys.exit(res.returncode)

    stdout_r, stdout_w = os.pipe()
    master_fd, slave_fd = pty.openpty()

    rows, cols, xpix, ypix = get_terminal_size(sys.stdin.fileno())
    set_terminal_size(slave_fd, rows, cols, xpix, ypix)

    def sigwinch_handler(sig, frame):
        r, c, xp, yp = get_terminal_size(sys.stdin.fileno())
        set_terminal_size(slave_fd, r, c, xp, yp)

    signal.signal(signal.SIGWINCH, sigwinch_handler)

    pid = os.fork()
    if pid == 0:
        os.close(master_fd)
        os.close(stdout_r)
        os.dup2(slave_fd, 0)
        os.dup2(stdout_w, 1)
        os.dup2(slave_fd, 2)
        os.close(slave_fd)
        os.close(stdout_w)
        os.execvp("gum", ["gum", "choose"] + args)

    os.close(slave_fd)
    os.close(stdout_w)

    old_tty = None
    try:
        old_tty = termios.tcgetattr(sys.stdin.fileno())
        tty.setraw(sys.stdin.fileno())
    except Exception:
        pass

    try:
        while True:
            r, _, _ = select.select([sys.stdin.fileno(), master_fd], [], [])
            if sys.stdin.fileno() in r:
                try:
                    data = os.read(sys.stdin.fileno(), 1024)
                    if not data:
                        break
                    new_data = bytearray()
                    for b in data:
                        if b == 0x20:
                            new_data.append(0x78)  # Translate Space (0x20) to 'x' (0x78) for gum
                        else:
                            new_data.append(b)
                    os.write(master_fd, bytes(new_data))
                except Exception:
                    break

            if master_fd in r:
                try:
                    data = os.read(master_fd, 1024)
                    if not data:
                        break
                    sys.stderr.buffer.write(data)
                    sys.stderr.buffer.flush()
                except Exception:
                    break
    finally:
        if old_tty:
            try:
                termios.tcsetattr(sys.stdin.fileno(), termios.TCSADRAIN, old_tty)
            except Exception:
                pass

    _, status = os.waitpid(pid, 0)

    out = b""
    while True:
        try:
            chunk = os.read(stdout_r, 4096)
            if not chunk:
                break
            out += chunk
        except Exception:
            break
    os.close(stdout_r)

    sys.stdout.buffer.write(out)
    sys.stdout.buffer.flush()
    sys.exit(os.WEXITSTATUS(status) if os.WIFEXITED(status) else 1)

if __name__ == "__main__":
    main()
